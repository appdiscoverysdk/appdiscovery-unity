# Versions of the neutral native SDKs this wrapper builds against.
# Android: JitPack coordinates com.github.appdiscoverysdk:appdiscovery-android:<version>
# iOS: AppDiscoverySDK.xcframework.zip from the appdiscovery-ios release <version>;
#      the sha256 is the SwiftPM checksum published in that repository's Package.swift.
APPDISCOVERY_ANDROID_VERSION=1.0.0
APPDISCOVERY_IOS_VERSION=1.0.0
APPDISCOVERY_IOS_ZIP_SHA256=42d4c0bc37c27621b6999424d86bb6dca83d9ceafe66c4c43d8f16dcdf104b5a
